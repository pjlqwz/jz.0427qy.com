---
// 站2 服务总览 /prodect/（2026-10-21 改为「全部服务」汇总页，URL 不变）
// 定位：把分散在产品页里的服务收成一张目录，客户按阶段自己找入口
// 参考结构：lnhopefull.com/services/（分组编号 + 卡片 + 一句描述 + 指向详情）
// 铁律：本页每个链接都必须真能到，不放假入口；数字从数据现算，不手写
import Base from '../../layouts/Base.astro';
import { TEL } from '../../data/cases.js';
import { SITE } from '../../config/site.js';
import { INDUSTRIES } from '../../data/industries.js';

import { TEMPLATES } from '../../data/templates.js';
import { shotOf } from '../../lib/tpl-shot.js';

// 成品站超市在锦州站用一个列表页 + 全屏框架层承载（不生成 60 个详情页 URL，
// 避免与主站重复）。客户该有的能力一个不少：看图、当场点开真站、知道要改什么。
// 数字一律从数据现算——手写会让「60 个」和「54 个能看真站」两处对不上。
const IND_N = INDUSTRIES.length;
const TPL_ALL = TEMPLATES.length;
const TPL_LIVE = TEMPLATES.filter((t) => shotOf(t).live).length;

const GROUPS = [
  {
    no: '01',
    id: 'new',
    title: '新业务',
    sub: '面向当下的增量能力',
    cols: 2,
    items: [
      {
        name: '企业 AI 效能提升',
        desc: '把重复的文案、整理、汇报环节交给智能体，让人从琐碎工作里脱身。转型、培训、部署、驻场都能接。',
        href: '/prodect/wzcz.html#eff',
        more: '看能落地哪些环节',
      },
      {
        name: '一人公司创业陪跑',
        desc: '面向一人公司的起步期，从定位、产品到获客，全程给可执行建议，不讲大词。',
        href: '/prodect/wzcz.html#opc',
        more: '看陪跑怎么进行',
      },
    ],
  },
  {
    no: '02',
    id: 'old',
    title: '传统业务',
    sub: '数字化建设的基本盘',
    cols: 3,
    items: [
      {
        name: '网站建设',
        desc: '响应式三合一企业官网，兼顾品牌形象与搜索获客，PC 与手机端都好用。500 / 1000 / 3000 三档，价格写在页上。',
        href: '/prodect/wzjs.html',
        more: '三档报价与交付标准',
      },
      {
        name: '成品站超市',
        desc: `${TPL_ALL} 个按行业做好的站，${TPL_LIVE} 个能当场点开看真站。挑中即改内容上线，周期最短。`,
        href: '/template/',
        more: '进去挑一个',
      },
      {
        name: '锦州行业方案',
        desc: `按锦州的产业结构给方案：五大主导产业 + 三大特色产业 + 港口物流，共 ${IND_N} 个行业，每个写清痛点与三层做法。`,
        href: '/industry/',
        more: '按行业看方案',
      },
      {
        name: 'SEO 优化',
        desc: '从关键词研究到内容结构、站内优化，让目标客户在搜索里找到你。纯白帽，不做快排。',
        href: '/prodect/wztg.html',
        more: '看 SEO 怎么做',
      },
      {
        name: 'GEO · AI 搜索优化',
        desc: '客户开始问 AI，而不是翻十条链接。让机器读懂你是谁，在回答里被提到。',
        href: '/prodect/wztg.html#geo',
        more: '六条方法与边界',
      },
      {
        name: '小程序开发',
        desc: '商城、预约、会员、内部管理，扫码即用无需下载。做出来的样子可以先点开看。',
        href: '/prodect/wzyw.html#mp',
        more: '看小程序能做什么',
      },
      {
        name: 'APP 与系统开发',
        desc: 'iOS / 安卓定制开发，以及把还在纸上、微信里的流程搬进系统：审批、台账、报表、权限。',
        href: '/prodect/wzyw.html#app',
        more: '看开发范围',
      },
    ],
  },
];

// 服务条目数从 GROUPS 现算，description 与 ItemList 共用，避免两处手写对不上
const SVC_N = GROUPS.reduce((n, g) => n + g.items.length, 0);

// 目录页正确类型：ItemList（服务清单），不是报价 OfferCatalog——报价在 /prodect/wzjs.html
const ITEMLIST = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: '千羽网络服务总览',
  url: 'https://jz.0427qy.com/prodect/',
  numberOfItems: SVC_N,
  itemListElement: GROUPS.flatMap((g) =>
    g.items.map((it) => ({
      '@type': 'ListItem',
      name: it.name,
      description: it.desc,
      url: `https://jz.0427qy.com${it.href.split('#')[0]}`,
    }))
  ),
};
---

<Base
  title="报价与交付周期一览｜锦州业务·千羽网络"
  description={`千羽网络 ${SVC_N} 项服务一览：网站建设三档报价（500/1000/3000）、交付标准与周期、小程序与系统开发、SEO 与 GEO、企业 AI 效能提升、一人公司陪跑。价格与周期都写在页上，每项标清交付边界，按阶段挑，不打包推销。电话/微信 18624274046。`}
  canonical="https://jz.0427qy.com/prodect/"
  keywords="锦州网络公司,锦州网站建设,锦州SEO优化,锦州小程序开发,企业AI服务,一人公司"
  jsonld={ITEMLIST}
>
  <!-- 首屏 -->
  <section class="hero">
    <div class="wrap">
      <nav class="crumbs"><a href="/">首页</a> › 全部服务</nav>
      <span class="hero-kicker">服务总览</span>
      <h1>千羽网络的全部服务</h1>
      <p>从品牌官网到业务系统，从内容获客到 AI 提效，按你现在的阶段挑一项开始。每项都标了价格或交付边界，点进去能看到具体做什么、不做什么。</p>
      <div class="hero-jump">
        {GROUPS.map((g) => (
          <a href={`#${g.id}`}><b>{g.no}</b>{g.title}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {GROUPS.map((g) => (
        <div class="grp" id={g.id}>
          <div class="grp-head">
            <span class="grp-no">{g.no}</span>
            <div class="grp-ttl">
              <h2>{g.title}</h2>
              <p>{g.sub}</p>
            </div>
          </div>
          <div class={`grp-grid cols-${g.cols}`}>
            {g.items.map((it) => (
              <a class="svc" href={it.href}>
                <h3>{it.name}</h3>
                <p>{it.desc}</p>
                <span class="svc-more">{it.more}<i aria-hidden="true">→</i></span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <!-- 次级入口：不属于「服务」，但客户常要看 -->
      <div class="more-line">
        <span>还想看点别的</span>
        <a href="/case/">案例展示</a>
        <a href="/wx/">小程序 15 个功能现场演示</a>
        <a href="/news/">行业资讯</a>
        <a href="/about/">关于千羽</a>
      </div>

      <!-- 底部 CTA -->
      <div class="bottom-cta">
        <div>
          <h2>不确定该选哪项？</h2>
          <p>说说你现在卡在哪一步：是新客找不到你，还是人太少干不完活。我给的第一个建议，可能是「这项你不用做」。</p>
        </div>
        <div class="cta-btns">
          <a class="btn btn-primary" href={`tel:${TEL}`}>电话咨询 186-2427-4046</a>
          <a class="btn btn-ghost" href="/case/">先看案例</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* 首屏：品牌深红渐变，与普通内容页区分，作为「总入口」有点份量 */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, oklch(0.42 0.15 27) 0%, oklch(0.26 0.09 25) 100%);
    color: #fff;
    padding: 40px 0 56px;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(58% 78% at 86% 8%, oklch(0.62 0.17 30 / 0.34), transparent 62%);
    pointer-events: none;
  }
  .hero .wrap { position: relative; z-index: 1; }
  .hero .crumbs { color: oklch(1 0 0 / 0.66); }
  .hero .crumbs a { color: oklch(1 0 0 / 0.66); }
  .hero .crumbs a:hover { color: #fff; }
  .hero-kicker {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
    color: oklch(1 0 0 / 0.8);
  }
  .hero-kicker::before { content: ""; width: 22px; height: 2px; background: oklch(1 0 0 / 0.6); border-radius: 1px; }
  .hero h1 {
    font-size: clamp(28px, 3.8vw, 44px); line-height: 1.22; font-weight: 700;
    letter-spacing: -0.02em; margin: 14px 0 16px;
  }
  .hero p { font-size: 15.5px; line-height: 1.8; color: oklch(1 0 0 / 0.84); max-width: 58ch; margin: 0; }
  .hero-jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .hero-jump a {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; color: #fff;
    border: 1px solid oklch(1 0 0 / 0.3); border-radius: 999px; padding: 8px 16px;
    transition: background 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .hero-jump a b { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; color: oklch(1 0 0 / 0.6); }
  .hero-jump a:hover { background: oklch(1 0 0 / 0.14); border-color: oklch(1 0 0 / 0.6); color: #fff; }

  /* 分组 */
  .grp { margin-bottom: 72px; scroll-margin-top: 92px; }
  .grp-head {
    display: flex; align-items: center; gap: 20px;
    padding-bottom: 18px; border-bottom: 1px solid var(--line); margin-bottom: 28px;
  }
  .grp-no {
    font-size: clamp(30px, 3.4vw, 42px); font-weight: 700; line-height: 1;
    letter-spacing: -0.03em; color: oklch(0.80 0.018 60);
  }
  .grp-ttl h2 { font-size: clamp(22px, 2.6vw, 28px); font-weight: 700; letter-spacing: -0.01em; margin: 0; color: var(--ink); }
  .grp-ttl p { font-size: 13.5px; color: var(--ink-3); margin: 5px 0 0; }

  /* 卡片 */
  .grp-grid { display: grid; gap: 18px; }
  .cols-2 { grid-template-columns: repeat(2, 1fr); }
  .cols-3 { grid-template-columns: repeat(3, 1fr); }
  .svc {
    display: flex; flex-direction: column; gap: 10px;
    background: #fff; border: 1px solid var(--line); border-radius: var(--r2);
    padding: 24px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .svc:hover {
    border-color: oklch(0.82 0.05 27);
    box-shadow: 0 10px 32px oklch(0.3 0.02 45 / 0.07);
    transform: translateY(-2px);
  }
  .svc h3 { font-size: 18.5px; font-weight: 700; letter-spacing: -0.01em; margin: 0; color: var(--ink); }
  .svc p { font-size: 13.5px; line-height: 1.75; color: var(--ink-2); margin: 0; }
  .svc-more {
    margin-top: auto; padding-top: 8px;
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 13px; font-weight: 600; color: var(--brand);
  }
  .svc-more i { font-style: normal; transition: transform 0.2s var(--ease); }
  .svc:hover .svc-more i { transform: translateX(4px); }

  /* 次级入口 */
  .more-line {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px;
    padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    margin-bottom: 56px;
  }
  .more-line span { font-size: 12.5px; font-weight: 700; letter-spacing: 0.06em; color: var(--ink-3); }
  .more-line a { font-size: 13.5px; font-weight: 600; color: var(--ink-2); }
  .more-line a:hover { color: var(--brand); }

  /* 底部 CTA */
  .bottom-cta {
    display: flex; justify-content: space-between; align-items: center; gap: 32px;
    background: var(--brand); color: #fff; border-radius: var(--r3); padding: 40px;
  }
  .bottom-cta h2 { font-size: 22px; font-weight: 700; margin: 0 0 8px; }
  .bottom-cta p { font-size: 14px; line-height: 1.75; color: oklch(0.95 0.015 27); margin: 0; max-width: 52ch; }
  .cta-btns { display: flex; gap: 10px; flex-shrink: 0; }
  .bottom-cta .btn-primary { background: #fff; color: var(--brand-deep); white-space: nowrap; }
  .bottom-cta .btn-primary:hover { background: oklch(0.96 0.01 27); color: var(--brand-deep); }
  .bottom-cta .btn-ghost { background: transparent; border-color: oklch(1 0 0 / 0.5); color: #fff; white-space: nowrap; }
  .bottom-cta .btn-ghost:hover { background: oklch(1 0 0 / 0.12); border-color: #fff; color: #fff; }

  @media (max-width: 980px) {
    .cols-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .hero { padding: 32px 0 40px; }
    .hero-jump { margin-top: 22px; }
    .grp { margin-bottom: 52px; }
    .grp-head { gap: 14px; padding-bottom: 14px; margin-bottom: 20px; }
    .cols-2, .cols-3 { grid-template-columns: 1fr; }
    .svc { padding: 20px; }
    .bottom-cta { flex-direction: column; align-items: flex-start; padding: 28px; gap: 20px; }
    .cta-btns { flex-direction: column; width: 100%; }
    .cta-btns .btn { justify-content: center; }
  }
</style>
