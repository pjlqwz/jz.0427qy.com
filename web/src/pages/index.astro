<script>
  // 轮播：scroll-snap + 自动播放（尊重 prefers-reduced-motion）
  const track = document.getElementById('hero-track');
  const dots = Array.from(document.querySelectorAll('.dot'));
  if (track && dots.length) {
    let idx = 0;
    let timer: number | undefined;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const go = (i: number) => {
      idx = (i + dots.length) % dots.length;
      track.scrollTo({ left: idx * track.clientWidth, behavior: 'smooth' });
      dots.forEach((d, k) => {
        d.classList.toggle('is-active', k === idx);
        d.setAttribute('aria-selected', k === idx ? 'true' : 'false');
      });
    };

    dots.forEach((d) => d.addEventListener('click', () => { go(Number(d.dataset.go)); restart(); }));

    const start = () => { if (!reduced) timer = window.setInterval(() => go(idx + 1), 5200); };
    const stop = () => { if (timer) window.clearInterval(timer); timer = undefined; };
    const restart = () => { stop(); start(); };

    track.addEventListener('pointerenter', stop);
    track.addEventListener('pointerleave', start);
    track.addEventListener('focusin', stop);
    track.addEventListener('scroll', () => {
      const near = Math.round(track.scrollLeft / track.clientWidth);
      if (near !== idx) {
        idx = near;
        dots.forEach((d, k) => {
          d.classList.toggle('is-active', k === idx);
          d.setAttribute('aria-selected', k === idx ? 'true' : 'false');
        });
      }
    }, { passive: true });

    start();
  }
</script>
