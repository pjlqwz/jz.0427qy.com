---
// 站2 产品页：网站建设 /prodect/wzjs.html（2026-10-18 随新设计重做，URL 不变）
import Base from '../../layouts/Base.astro';
import { TEL } from '../../data/cases.js';
import { SITE } from '../../config/site.js';
// 数量从数据现算，不手写——列表页改了这里自动跟着变，不会出现两处数字对不上
import { TEMPLATES } from '../../data/templates.js';
import { shotOf } from '../../lib/tpl-shot.js';
const TPL_ALL = TEMPLATES.length;
const TPL_LIVE = TEMPLATES.filter((t) => shotOf(t).live).length;
import { INDUSTRIES } from '../../data/industries.js';
// 数量从数据里算，不手写
const IND_N = INDUSTRIES.length;

const TIERS = [
  { id: 'ready', name: '成品建站', price: '500 元起', fit: '预算优先、要快速上线', desc: '成品站超市直接选择已经提前做好的网站成品，替换图片文字为自己内容即可使用，建站周期短，费用低廉。' },
  { id: 'copy', name: '仿制建站', price: '1000 元起', fit: '看中同行设计、要性价比', desc: '选择喜欢的同行或不同行网站，由我们进行仿制，以较低设计成本获取高端网站设计。' },
  { id: 'custom', name: '定制化建站', price: '3000 元起', fit: '业务有特殊流程、要完全贴合', desc: '根据客户需求完全定制化设计，从设计到修改一直到最终代码编写，层层审核、层层确认。' },
];

const FLOW = [
  { no: '1', name: '沟通需求', desc: '电话或微信聊清楚业务、客户群体和这个网站要解决什么问题。' },
  { no: '2', name: '确认方案', desc: '定档位、定栏目结构、定页面清单，白纸黑字确认后再动手。' },
  { no: '3', name: '设计开发', desc: '响应式三合一（电脑 / 平板 / 手机），SEO 站内优化同步做，不是上线后再补。' },
  { no: '4', name: '上线调试', desc: '专人辅助上线，域名、主机、备案、统计代码调试至最佳状态。' },
  { no: '5', name: '售后维护', desc: '免费至少一年托管维护 + 后台培训，出问题找得到人。' },
];
---

<Base
  title="锦州网站建设三档报价·500元起｜千羽网络"
  description="锦州网站建设三档报价：成品建站500元起、仿制建站1000元起、定制建站3000元起。SEO优化先行，八包服务，有人维护。电话/微信18624274046。"
  canonical="https://jz.0427qy.com/prodect/wzjs.html"
  keywords="锦州网站建设,锦州做网站,锦州建网站,响应式网站,网站制作"
>
  <section class="section">
    <div class="wrap">
      <nav class="crumbs"><a href="/">首页</a> › 网站建设</nav>
      <div class="sec-head">
        <span class="kicker">网站建设</span>
        <h1 class="page-title">说一千道一万，能赚钱的才是好网站</h1>
        <p>解决网络营销的核心问题：客户搜得到、看得到、能联系上。三合一响应式，SEO 站内优化先行，上线后有人维护。</p>
      </div>

      <!-- 三档对比 -->
      <div class="tier-grid">
        {TIERS.map((t) => (
          <div class="tier-card" id={t.id}>
            <h2>{t.name}</h2>
            <div class="tier-price">{t.price}</div>
            <span class="tier-fit">适合：{t.fit}</span>
            <p>{t.desc}</p>
            {t.id === 'ready' && (
              <a class="tier-cta" href="/template/">进成品站超市挑：{TPL_ALL} 个，{TPL_LIVE} 个能当场看真站 →</a>
            )}
          </div>
        ))}
      </div>

      <!-- 合作流程 -->
      <div class="flow-block">
        <div class="sec-head">
          <span class="kicker">合作流程</span>
          <h2>五步，从聊天到上线</h2>
        </div>
        <ol class="flow-list">
          {FLOW.map((f) => (
            <li>
              <span class="flow-no">{f.no}</span>
              <div>
                <h3>{f.name}</h3>
                <p>{f.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- 交叉引导 -->
      <div class="cross-cta">
        <div>
          <span class="kicker kicker-light">比网站更进一步</span>
          <h2>网站解决「被找到」，AI 解决「跑得快」</h2>
          <p>如果你的瓶颈已经不是「没有网站」，而是「重复性工作吃掉人力」，建议看企业 AI 服务——把流程理清楚，把智能体放进去。</p>
        </div>
        <div class="cross-actions">
          <a class="btn btn-primary" href="/prodect/wzcz.html">了解企业 AI 服务</a>
          <a class="btn btn-ghost" href={`tel:${TEL}`}>电话咨询</a>
        </div>
      </div>

      <!-- 其他产品 -->
      <nav class="sibling" aria-label="其他产品">
        <span>其他产品：</span>
        <a href="/prodect/wztg.html">网络推广</a>
        <a href="/prodect/wzyw.html">软件开发</a>
        <a href="/prodect/wzcz.html">企业 AI 服务</a>
        <a href="/industry/">锦州行业方案（{IND_N} 个行业）</a>
        <a href="/prodect/">全部服务总览 →</a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .page-title { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.3; font-weight: 700; letter-spacing: -0.01em; margin: 0 0 16px; }
  .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 64px; }
  .tier-card {
    background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 28px;
    display: flex; flex-direction: column; gap: 10px; scroll-margin-top: 92px;
    transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  .tier-cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 4px; margin-top: 6px;
    font-size: 13.5px; font-weight: 600; color: var(--brand); text-align: center;
    background: var(--brand-soft); border: 1px solid oklch(0.9 0.045 27);
    border-radius: 10px; padding: 10px 14px;
    transition: background 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .tier-cta:hover { background: var(--brand); border-color: var(--brand); color: #fff; }
  .tier-card:hover { border-color: oklch(0.82 0.05 27); box-shadow: 0 8px 30px oklch(0.3 0.02 45 / 0.06); }
  /* 从导航二级跳进来时高亮，否则客户跳完不知道看哪一块 */
  .tier-card:target { border-color: var(--brand); box-shadow: 0 8px 30px oklch(0.55 0.14 27 / 0.14); }
  .tier-card h2 { font-size: 19px; font-weight: 700; margin: 0; }
  .tier-price { font-size: 26px; font-weight: 700; color: var(--brand); }
  .tier-fit { font-size: 12.5px; color: var(--ink-3); }
  .tier-card p { font-size: 13.5px; color: var(--ink-2); margin: 0; flex: 1; }
  .flow-block { margin-bottom: 64px; }
  .flow-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .flow-list li {
    display: flex; gap: 16px; align-items: flex-start; background: var(--bg-warm);
    border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px;
  }
  .flow-no {
    width: 34px; height: 34px; border-radius: 50%; background: var(--brand); color: #fff;
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; flex-shrink: 0;
  }
  .flow-list h3 { font-size: 16px; font-weight: 700; margin: 4px 0 4px; }
  .flow-list p { font-size: 13.5px; color: var(--ink-2); margin: 0; }
  .cross-cta {
    display: flex; justify-content: space-between; align-items: center; gap: 32px;
    background: var(--dark); color: #fff; border-radius: 16px; padding: 40px; margin-bottom: 40px;
  }
  .cross-cta h2 { font-size: 21px; font-weight: 700; margin: 0 0 10px; }
  .cross-cta p { font-size: 14px; color: oklch(0.75 0.01 60); margin: 0; max-width: 52ch; }
  .cross-actions { display: flex; flex-direction: column; gap: 10px; flex-shrink: 0; }
  .cross-actions .btn-ghost { background: transparent; color: #fff; border-color: oklch(0.45 0.01 60); }
  .cross-actions .btn-ghost:hover { border-color: #fff; color: #fff; }
  .sibling { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: 13.5px; color: var(--ink-3); }
  .sibling a { color: var(--brand); text-decoration: underline; }
  @media (max-width: 900px) {
    .tier-grid { grid-template-columns: 1fr; }
    .cross-cta { flex-direction: column; align-items: flex-start; padding: 28px; }
    .cross-actions { flex-direction: row; }
  }
</style>
