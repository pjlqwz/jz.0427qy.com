---
import Kefu from '../components/Kefu.astro';
import { SITE, ORG } from '../config/site.js';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  keywords?: string;
  jsonld?: object;
  /** 客服弹窗的语境文案；不传就用全站默认（一对一咨询） */
  kefuTitle?: string;
  kefuSub?: string;
}
const { title, description = '', canonical, noindex = false, keywords = '', jsonld, kefuTitle, kefuSub } = Astro.props;
// 锦州城市站导航（2026-10-22）。
// 与主站的两处差异：
//   1. 一级多出「锦州行业方案」——城市站的核心差异内容，按锦州官方产业口径写落地页；
//   2. 「成品站超市 /template/」与「小程序展厅 /wx/」是通用产品资产，本站以框架形式重建
//      （左总 2026-10-22 拍板），导航正常放入——点进去有东西，不重复主站 URL。
// 二级项全部指向**已存在**的页面或页面内锚点。
const NAV = [
  {
    href: '/about/',
    label: '关于千羽',
    children: [
      { href: '/about/', label: '公司简介' },
      { href: '/news/', label: '行业资讯' },
    ],
  },
  {
    href: '/prodect/wzcz.html',
    label: '企业 AI 服务',
    children: [
      { href: '/prodect/wzcz.html#opc', label: '一人公司' },
      { href: '/prodect/wzcz.html#eff', label: '企业 AI 效能提升' },
    ],
  },
  {
    href: '/prodect/wzjs.html',
    label: '网站建设',
    children: [
      { href: '/template/', label: '成品建站 · 成品站超市' },
      { href: '/prodect/wzjs.html#copy', label: '仿制建站' },
      { href: '/prodect/wzjs.html#custom', label: '定制化建站' },
      { href: '/industry/', label: '按行业看建站方案' },
    ],
  },
  {
    href: '/industry/',
    label: '锦州行业方案',
    children: [
      { href: '/industry/petrochem.html', label: '石化及精细化工' },
      { href: '/industry/metallurgy.html', label: '冶金与新材料' },
      { href: '/industry/agri-food.html', label: '农副产品加工' },
      { href: '/industry/tourism.html', label: '文旅与红色研学' },
      { href: '/industry/', label: '全部行业方案 →' },
    ],
  },
  {
    href: '/prodect/wztg.html',
    label: '网络推广',
    children: [
      // SEO 整页就是这件事，不加锚点——带锚点会跳过 H1，客户落地时看不到页面标题
      { href: '/prodect/wztg.html', label: 'SEO 优化' },
      { href: '/prodect/wztg.html#geo', label: 'GEO · AI 搜索优化' },
    ],
  },
  {
    href: '/prodect/wzyw.html',
    label: '软件开发',
    children: [
      { href: '/prodect/wzyw.html#erp', label: '企业信息化系统' },
      { href: '/prodect/wzyw.html#app', label: 'APP 定制开发' },
      { href: '/prodect/wzyw.html#mp', label: '小程序开发' },
      { href: '/wx/', label: '小程序能力展厅' },
    ],
  },
  {
    href: '/case/',
    label: '案例展示',
  },
  {
    href: '/contect/',
    label: '联系我们',
  },
];

// 当前页高亮：一级项和它的二级项一起参与匹配，取最长命中，高亮落在所属一级上。
// 这样进 /template/（成品站超市）时亮的是一级「网站建设」，而不是某个不相干的项。
//
// ⚠️ 必须先把两边的 .html 都去掉再比：本项目 build.format='preserve'，
// 但 Astro 构建时拿到的 pathname 是**不带 .html** 的（/prodect/wztg），
// 而导航 href 是带 .html 的（/prodect/wztg.html）。不归一化的话两者永远不等，
// 只剩 /prodect 这个短前缀能匹配，结果四个产品页全高亮成「网站建设」（踩过一次）。
const norm = (s: string) => s.replace(/\.html$/, '').replace(/\/+$/, '');
const path = norm(Astro.url.pathname) || '/';
const navCandidates = NAV.flatMap((n) => [
  { base: norm(n.href.split('#')[0]), top: n.href },
  ...(n.children || []).map((c) => ({ base: norm(c.href.split('#')[0]), top: n.href })),
  // /prodect/ 是四个产品页的汇总入口，归到「网站建设」这一支
  ...(n.href === '/prodect/wzjs.html' ? [{ base: '/prodect', top: n.href }] : []),
]).filter((c) => c.base && c.base !== '/');
const best = navCandidates
  .filter((c) => path === c.base || path.startsWith(c.base + '/'))
  .sort((a, b) => b.base.length - a.base.length)[0];
const activeHref = best ? best.top : path === '/' ? '/' : '';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ORG)} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav-wrap">
        <a class="brand" href="/">
          <img src="/images/logo.png" alt="千羽网络" width="120" height="37" />
        </a>
        <nav class="nav" id="site-nav" aria-label="主导航">
          <ul class="nav-list">
            {NAV.map((n) => (
              <li class={n.children ? 'nav-item has-sub' : 'nav-item'}>
                <a
                  href={n.href}
                  class={n.href === activeHref ? 'is-active' : undefined}
                  aria-current={n.href === activeHref ? 'page' : undefined}
                >
                  {n.label}{n.children && <span class="nav-caret" aria-hidden="true">▾</span>}
                </a>
                {n.children && (
                  <ul class="nav-sub">
                    {n.children.map((c) => (
                      <li>
                        <a href={c.href}>{c.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </nav>
        <a class="nav-cta" href={`tel:${SITE.tel}`}>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="cta-text">电话咨询</span>
        </a>
        <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label="打开菜单">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div class="footer-brand">
          <img src="/images/logo.png" alt="千羽网络" width="140" height="43" />
          <p>千羽网络（千羽亿维（盘锦）网络科技有限公司），团队在盘锦，服务覆盖锦州及辽西地区。近 20 年企业信息化经验，自身业务全流程跑在智能体上，把验证过的方法交付给企业。</p>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">服务</p>
          <a href="/prodect/wzcz.html">企业 AI 服务</a>
          <a href="/prodect/wzjs.html">网站建设</a>
          <a href="/template/">成品站超市</a>
          <a href="/industry/">锦州行业方案</a>
          <a href="/prodect/wztg.html">网络推广 SEO / GEO</a>
          <a href="/prodect/wzyw.html">软件开发</a>
          <a href="/prodect/">全部服务总览</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">关于</p>
          <a href="/about/">关于千羽</a>
          <a href="/case/">案例展示</a>
          <a href="/wx/">小程序能力展厅</a>
          <a href="/news/">行业资讯</a>
          <a href="/contect/">联系我们</a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title">联系</p>
          <a href={`tel:${SITE.tel}`}>电话 / 微信：{SITE.tel}（{SITE.contactPerson}）</a>
          <span>邮箱：{SITE.email}</span>
          <span>办公地：辽宁 · {SITE.hqCity}（服务区域含{SITE.city}）</span>
        </div>
        <div class="footer-col footer-qr">
          <p class="footer-col-title">企业微信</p>
          <img src="/images/wecom-qr.png" alt="企业微信客服二维码" width="108" height="108" loading="lazy" />
          <span>扫码添加，咨询{SITE.city}企业 AI 落地</span>
        </div>
      </div>
      <div class="wrap footer-bar">
        <p>© {new Date().getFullYear()} 千羽网络 · <a href="https://beian.miit.gov.cn/" target="_blank" rel="nofollow">{SITE.beian}</a></p>
      </div>
    </footer>
    <Kefu title={kefuTitle} sub={kefuSub} />
    <script>
      // 移动端汉堡菜单：开关 / 点链接收起 / Esc 收起 / 回到桌面自动收起
      const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
      const nav = document.getElementById('site-nav');
      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
          nav.classList.toggle('is-open', open);
          document.body.classList.toggle('nav-open', open);
        };
        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        nav.addEventListener('click', (e) => {
          if ((e.target as Element).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
        window.matchMedia('(min-width: 901px)').addEventListener('change', (ev) => {
          if (ev.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  /* ===== 设计系统：frontend-design-pro 规范 + 千羽品牌红 ===== */
  :root {
    /* 品牌色：logo 红 #b32c29 转 OKLCH */
    --brand: oklch(0.48 0.17 27);
    --brand-deep: oklch(0.40 0.14 27);
    --brand-soft: oklch(0.965 0.018 27);
    /* 暖调中性色（带色调，非纯灰） */
    --ink: oklch(0.24 0.008 60);
    --ink-2: oklch(0.45 0.012 60);
    --ink-3: oklch(0.60 0.012 60);
    --line: oklch(0.90 0.008 60);
    --bg: #ffffff;
    --bg-warm: oklch(0.975 0.006 60);
    --dark: oklch(0.22 0.01 45);
    --dark-2: oklch(0.30 0.012 45);
    --ok: oklch(0.55 0.13 150);
    --warn: oklch(0.65 0.14 75);
    /* 间距：8px 基数 */
    --s1: 8px; --s2: 16px; --s3: 24px; --s4: 32px; --s5: 48px; --s6: 64px; --s7: 96px;
    /* 圆角 */
    --r1: 8px; --r2: 12px; --r3: 16px;
    /* 动效 */
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --font-sans: "Geist", "HarmonyOS Sans SC", "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--bg);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.75;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--brand); text-decoration: none; }
  a:hover { color: var(--brand-deep); }
  img { max-width: 100%; height: auto; }
  :focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; border-radius: 4px; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 var(--s3); }

  /* ===== 顶部导航 ===== */
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: oklch(1 0 0 / 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-wrap { display: flex; align-items: center; gap: var(--s4); height: 68px; }
  .brand img { display: block; height: 34px; width: auto; }
  .nav { display: flex; gap: var(--s1); flex: 1; }
  .nav-list { display: flex; align-items: center; gap: 1px; list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; }
  .nav-item > a {
    display: flex; align-items: center; gap: 3px;
    color: var(--ink-2); font-size: 15px; padding: var(--s1) 11px; white-space: nowrap;
    border-radius: var(--r1); transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .nav-item > a:hover { color: var(--brand); background: var(--brand-soft); }
  .nav-item > a.is-active { color: var(--brand); font-weight: 600; background: var(--brand-soft); }
  /* 用 border 画三角，比 ▾ 字符清楚：字符在 9px 时几乎看不见，客户不知道能展开 */
  .nav-caret {
    display: inline-block; width: 0; height: 0; font-size: 0; line-height: 0;
    border-left: 3.5px solid transparent; border-right: 3.5px solid transparent;
    border-top: 4px solid currentColor;
    opacity: 0.6; transition: transform 0.18s var(--ease);
  }
  .nav-item:hover .nav-caret { transform: rotate(180deg); }
  /* 从一级项划到下拉之间的 13px 是 header 空白，鼠标经过会触发 mouseleave →
     下拉闪掉。用一层透明伪元素把这段接上（这条修过不止一次，别再删） */
  .nav-item.has-sub::after {
    content: ''; position: absolute; left: 0; right: 0; top: 100%; height: 14px;
  }
  .nav-sub {
    position: absolute; top: calc(100% + 13px); left: 0; z-index: 120;
    min-width: 208px; list-style: none; margin: 0; padding: 6px;
    background: #fff; border: 1px solid var(--line); border-radius: 12px;
    box-shadow: 0 14px 40px oklch(0.3 0.02 45 / 0.13);
    opacity: 0; visibility: hidden; transform: translateY(4px);
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease), visibility 0.16s;
  }
  .nav-item:hover .nav-sub,
  .nav-item:focus-within .nav-sub { opacity: 1; visibility: visible; transform: none; }
  .nav-sub a {
    display: block; font-size: 14px; color: var(--ink-2); padding: 9px 11px;
    border-radius: 8px; white-space: nowrap;
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .nav-sub a:hover { color: var(--brand); background: var(--brand-soft); }
  .nav-cta {
    display: inline-flex; align-items: center; gap: var(--s1);
    background: var(--brand); color: #fff; font-size: 14px; font-weight: 500;
    padding: 9px 18px; border-radius: var(--r1); white-space: nowrap;
    transition: background 0.15s var(--ease), transform 0.15s var(--ease);
  }
  .nav-cta:hover { background: var(--brand-deep); color: #fff; transform: translateY(-1px); }

  /* 汉堡按钮：桌面隐藏 */
  .nav-toggle {
    display: none; position: relative; width: 42px; height: 42px; flex: none;
    border: 1px solid var(--line); border-radius: var(--r1); background: #fff; cursor: pointer; padding: 0;
    transition: border-color 0.15s var(--ease);
  }
  .nav-toggle:hover { border-color: var(--brand); }
  .nav-toggle span {
    position: absolute; left: 11px; right: 11px; height: 2px; border-radius: 1px; background: var(--ink);
    transition: top 0.2s var(--ease), transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-toggle span:nth-child(1) { top: 14px; }
  .nav-toggle span:nth-child(2) { top: 20px; }
  .nav-toggle span:nth-child(3) { top: 26px; }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { top: 20px; transform: rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { top: 20px; transform: rotate(-45deg); }
  body.nav-open { overflow: hidden; }

  /* 7 个一级项在 901–1080 这段最容易挤爆（logo + 7 项 + 电话按钮 ≈ 950px），
     先把字号和左右内边距收一收，别等它溢出 */
  @media (max-width: 1080px) and (min-width: 901px) {
    .nav-wrap { gap: var(--s3); }
    .nav-item > a { font-size: 14px; padding: var(--s1) 8px; }
    .nav-cta { padding: 9px 14px; font-size: 13.5px; }
  }

  @media (max-width: 900px) {
    .nav-wrap { gap: var(--s2); }
    .nav-toggle { display: inline-block; margin-left: auto; }
    /* 抽屉：absolute 相对 header 下拉（header 有 backdrop-filter，fixed 会被 header 包含块捕获，故不用 fixed） */
    .nav {
      position: absolute; top: 100%; left: 0; right: 0; z-index: 99;
      flex-direction: column; gap: 0; flex: none;
      background: #fff; border-top: 1px solid var(--line);
      padding: var(--s3) var(--s3) var(--s5);
      max-height: calc(100vh - 69px); overflow-y: auto; overscroll-behavior: contain;
      transform: translateX(-100%); transition: transform 0.28s var(--ease);
      box-shadow: 4px 0 24px oklch(0.3 0.02 45 / 0.08);
    }
    .nav.is-open { transform: translateX(0); }
    /* 手机上不做「点击展开二级」的折叠交互 —— 多一次点击就多一次流失，
       二级直接铺开，缩进 + 浅底表示从属关系 */
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-item > a { padding: 13px 12px; font-size: 15.5px; border-radius: 0; border-bottom: 1px solid var(--line); justify-content: flex-start; gap: 6px; }
    .nav-item.has-sub > a { border-bottom: 0; }
    /* 手机上二级常驻展开，箭头没有「还有一层」的提示作用，留着反而让人以为要点 —— 直接去掉 */
    .nav-caret { display: none; }
    .nav-sub {
      position: static; opacity: 1; visibility: visible; transform: none;
      min-width: 0; padding: 2px 0 8px 12px; gap: 0;
      background: var(--bg-warm); border: 0; border-bottom: 1px solid var(--line);
      border-radius: 0; box-shadow: none;
    }
    .nav-sub a { padding: 8px 12px; font-size: 14px; line-height: 1.5; border-radius: 0; }
    /* 二级项外面还有一层 <li>，所以分隔线写在 li 上，写在 a 上永远不生效 */
    .nav-sub li + li { border-top: 1px dashed var(--line); }
    .nav-sub a.is-active { background: transparent; }
    .nav-cta { padding: 9px 13px; }
    .nav-cta .cta-text { display: none; }
  }

  /* ===== 页脚 ===== */
  .site-footer { margin-top: var(--s7); background: var(--dark); color: oklch(0.82 0.008 60); }
  .footer-grid {
    display: grid; grid-template-columns: 1.6fr 0.9fr 0.9fr 1.1fr auto; gap: var(--s4);
    padding-top: var(--s6); padding-bottom: var(--s5);
  }
  .footer-brand img { height: 40px; width: auto; margin-bottom: var(--s3); }
  .footer-brand p { font-size: 13.5px; line-height: 1.8; margin: 0; color: oklch(0.72 0.01 60); max-width: 42ch; }
  .footer-col .footer-col-title { font-size: 14px; font-weight: 600; color: #fff; margin: 0 0 var(--s3); letter-spacing: 0.05em; }
  .footer-col a, .footer-col span { display: block; font-size: 13.5px; color: oklch(0.78 0.01 60); padding: 5px 0; }
  .footer-col a:hover { color: #fff; }
  .footer-qr img { display: block; border-radius: var(--r1); background: #fff; padding: 4px; }
  .footer-qr span { font-size: 12px; color: oklch(0.66 0.01 60); margin-top: var(--s1); max-width: 12ch; }
