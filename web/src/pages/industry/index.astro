---
// 锦州行业方案 · 列表页
// 城市站的核心差异内容：按锦州官方口径的产业格局分组，每组给行业落地页入口。
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site.js';
import { INDUSTRIES, INDUSTRY_GROUPS, DATA_SOURCE } from '../../data/industries.js';

const groups = INDUSTRY_GROUPS.map((name) => ({
  name,
  items: INDUSTRIES.filter((x) => x.group === name),
})).filter((g) => g.items.length);
---

<Base
  title="锦州行业落地路径：按来料、熔炼、质检、出厂排｜千羽网络"
  description="行业不同，链条不同：合金看熔炼与炉号，石化看牌号与批次，农产品看产地与检疫。按来料、熔炼、质检、出厂这条链排方案，逐个行业讲清痛点，再说网站、小程序、系统分别怎么做。服务锦州及辽西。"
  canonical={`${SITE.domain}/industry/`}
  keywords="锦州行业信息化,锦州石化企业建站,锦州冶金新材料,锦州农副产品加工,锦州港口物流系统,锦州文旅小程序,锦州网站建设"
>
  <div class="wrap">
    <nav class="crumbs"><a href="/">首页</a> › 锦州行业方案</nav>

    <h1 class="page-title">锦州行业方案</h1>
    <p class="lede">
      锦州的产业结构摆在那里：石化及精细化工是第一支柱产业，冶金与新材料在全国有话语权（铬、钼铁、钛铁、工业锆产能分别占全国的 85%、60%、65%、90%），
      农副产品有锦州苹果、凌海香瓜、义县干豆腐这些牌子，港口和文旅是老本行。2024 年全市规上工业增加值同比增长 11.6%，居全省首位。
      产业不同，要解决的问题不同——石化厂的痛点是合规留痕，合金企业的痛点是批次追溯，文旅的痛点是旺季接不住。
      下面按行业拆开写，每个行业讲清楚：常见痛点、网站/小程序/系统分别怎么做、我们的建议。
    </p>

    {groups.map((g) => (
      <section class="grp">
        <h2 class="grp-title">{g.name}</h2>
        <div class="ind-grid">
          {g.items.map((it) => (
            <a class="ind-card" href={`/industry/${it.slug}.html`}>
              <b>{it.name}</b>
              <span>{it.stat}</span>
              <em>{it.pain}</em>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="src">{DATA_SOURCE}</p>

    <section class="cta-box">
      <div>
        <h2>你的行业不在这个列表里？</h2>
        <p>列表覆盖的是锦州体量最大的几块。无论哪个行业，做法都一样：先把流程和数据理清楚，再谈系统和 AI。把你的情况说一遍，我来判断从哪一步开始。</p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-primary" href={`tel:${SITE.tel}`}>电话 / 微信 {SITE.tel}</a>
        <a class="btn btn-ghost" href="/contect/">看联系方式</a>
      </div>
    </section>

    <nav class="rel">
      <span>相关服务</span>
      <a href="/prodect/wzjs.html">网站建设怎么交付 →</a>
      <a href="/prodect/wzyw.html">小程序与业务系统 →</a>
      <a href="/prodect/wztg.html">SEO 与 GEO 推广 →</a>
      <a href="/prodect/">全部服务总览 →</a>
    </nav>
  </div>
</Base>

<style>
  .page-title {
    font-size: clamp(26px, 3.4vw, 36px); line-height: 1.3; font-weight: 700;
    letter-spacing: -0.01em; margin: var(--s3) 0 var(--s2);
  }
  .crumbs { font-size: 13px; color: var(--ink-3); margin: var(--s3) 0 0; }
  .crumbs a { color: var(--ink-3); }
  .crumbs a:hover { color: var(--brand); }
  .lede {
    font-size: 15.5px; line-height: 1.85; color: var(--ink-2);
    max-width: 76ch; margin: 0 0 var(--s5);
  }
  .grp { margin-bottom: var(--s5); }
  .grp-title {
    font-size: 19px; font-weight: 700; margin: 0 0 var(--s3);
    padding-left: 11px; border-left: 3px solid var(--brand); letter-spacing: -0.01em;
  }
  .ind-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: var(--s2);
  }
  .ind-card {
    display: flex; flex-direction: column; gap: 5px; color: var(--ink);
    background: #fff; border: 1px solid var(--line); border-radius: var(--r2); padding: var(--s3);
    transition: border-color 0.15s var(--ease), transform 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .ind-card:hover {
    color: var(--ink); border-color: var(--brand); transform: translateY(-2px);
    box-shadow: 0 8px 24px oklch(0.3 0.02 45 / 0.08);
  }
  .ind-card b { font-size: 15.5px; }
  .ind-card span { font-size: 12.5px; font-weight: 600; color: var(--brand); }
  .ind-card em { font-style: normal; font-size: 13px; line-height: 1.7; color: var(--ink-3); }
  .src {
    font-size: 12.5px; color: var(--ink-3); line-height: 1.7;
    border-left: 3px solid var(--line); padding-left: 12px; margin: 0 0 var(--s5);
  }
  .cta-box {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s4); flex-wrap: wrap;
    background: var(--bg-warm); border: 1px solid var(--line); border-radius: var(--r3);
    padding: var(--s4); margin: 0 0 var(--s5);
  }
  .cta-box h2 { font-size: 19px; font-weight: 700; margin: 0 0 6px; letter-spacing: -0.01em; }
  .cta-box p { font-size: 14px; color: var(--ink-2); margin: 0; max-width: 58ch; line-height: 1.8; }
  .cta-actions { display: flex; gap: var(--s2); flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; gap: 6px; font-size: 14.5px; font-weight: 600;
    padding: 11px 20px; border-radius: var(--r1); border: 1px solid transparent; white-space: nowrap;
    transition: background 0.15s var(--ease), color 0.15s var(--ease), border-color 0.15s var(--ease);
  }
  .btn-primary { background: var(--brand); color: #fff; }
  .btn-primary:hover { background: var(--brand-deep); color: #fff; }
  .btn-ghost { border-color: var(--line); color: var(--ink-2); background: #fff; }
  .btn-ghost:hover { border-color: var(--brand); color: var(--brand); }
  .rel {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    border-top: 1px solid var(--line); padding-top: var(--s3); font-size: 14px;
  }
  .rel span { color: var(--ink-3); }
  .rel a { color: var(--brand); font-weight: 600; }
</style>
